# ResumeIQ Backend Environment Configuration
APP_NAME="ResumeIQ - AI Resume ATS Analyzer"
APP_VERSION="1.0.0"
DEBUG=False

# SQLite Database
DATABASE_URL="sqlite:///./resumeiq.db"

# Local Ollama AI Settings (Optional - falls back automatically to Rule Engine if offline)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=45.0

# Sentence Transformer Semantic Matching Model
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"
